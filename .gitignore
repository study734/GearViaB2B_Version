# Public repository allowlist
# Only application source, B2B deployment files, the README, and the customer PDF are published.
*

!.gitignore
!README.md
!B2BGearVia_B2B_설치운영_매뉴얼.pdf

!backend/
!backend/**
!frontend/
!frontend/**
!docs/
docs/*
!docs/contracts/
!docs/contracts/**
!infra/
infra/*
!infra/b2b/
!infra/b2b/**
!installer/
!installer/**

# Playwright demo automation is intentionally isolated from application code.
!e2e/
!e2e/**

# Build outputs and local runtime data
backend/target/
backend/logs/
backend/uploads/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Secrets, certificates, and local environment files
**/.env
**/.env.*
**/*.local
**/*.secret
**/*.secrets
**/secrets/
**/runtime.env
**/runtime.virtualbox.env
**/runtime.env.current
**/runtime.env.previous
**/deployment.env
**/ai.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/credentials.json
**/service-account*.json
**/mysql-root-password
infra/b2b/bootstrap/

# Editor, operating-system, logs, caches, and temporary files
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.log
**/*.tmp
**/*.swp
**/*.swo
**/.cache/
**/coverage/
**/*.iml
